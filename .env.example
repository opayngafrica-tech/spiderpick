# GEMINI_API_KEY: Optional for AI match summary generation
GEMINI_API_KEY="your-gemini-api-key"

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"

# Supabase Credentials (from Supabase Project Settings -> API)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# RapidAPI Football Credentials (free-api-live-football-data)
RAPIDAPI_KEY="your-rapidapi-key"
RAPIDAPI_HOST="free-api-live-football-data.p.rapidapi.com"

# API-Football Credentials (from RapidAPI or api-football.com)
API_FOOTBALL_KEY="your-api-football-key"
API_FOOTBALL_BASE_URL="https://v3.football.api-sports.io"

# Paystack Payment Credentials (from Paystack Dashboard -> Settings -> API Keys)
VITE_PAYSTACK_PUBLIC_KEY="pk_test_your_public_key"
PAYSTACK_PUBLIC_KEY="pk_test_your_public_key"
PAYSTACK_SECRET_KEY="sk_test_your_secret_key"
